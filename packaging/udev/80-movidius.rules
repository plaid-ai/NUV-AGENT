# Luxonis OAK/Movidius USB devices (upstream vendor id 03e7).
# Nuvion narrows the upstream world-writable access to the service group
# so an unprivileged process outside that group cannot control or reflash OAK.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="03e7", MODE="0660", GROUP="nuvion"
