[Unit]
Description=NUVION Agent privileged updater socket
After=systemd-tmpfiles-setup.service
Before=nuv-agent.service
Requires=nuvion-fleet-e2e-reconcile.service
After=nuvion-fleet-e2e-reconcile.service

[Socket]
ListenStream=/run/nuvion-updater/control.sock
SocketUser=root
SocketGroup=nuvion
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true

[Install]
WantedBy=sockets.target
